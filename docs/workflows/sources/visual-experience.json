{
  "cards": [
    {
      "dot": "cyan",
      "items": [
        "把产品目标、参考证据和视觉质量转成可审阅的界面、图片和动效候选。",
        "先理解目标和参考，再形成候选，桌面移动验证后才考虑交付。"
      ],
      "title": "工作目的与底层逻辑"
    },
    {
      "dot": "amber",
      "items": [
        "输出页面、组件、图片或动效实现。",
        "实验样式先截图审阅，不默认推送线上。",
        "输出实现、资源、截图和设计说明。"
      ],
      "title": "执行与授权"
    },
    {
      "dot": "emerald",
      "items": [
        "设计候选",
        "实现",
        "截图",
        "视觉审查",
        "桌面和移动视口均无关键布局缺陷。"
      ],
      "title": "输出与验收"
    },
    {
      "dot": "rose",
      "items": [
        "素材不匹配",
        "占位内容",
        "移动溢出",
        "参考无法授权"
      ],
      "title": "失败与恢复"
    },
    {
      "dot": "slate",
      "items": [
        "明确体验目标：定义用户、任务、内容层级和成功标准。",
        "收集参考与约束：记录真实资产、尺寸、品牌和平台边界。",
        "审查素材与结构：确认图片、文案、组件和参考来源。",
        "选择视觉方向：比较层级、密度、字体、色彩和交互策略。",
        "桌面移动视觉审查：检查文字、间距、溢出、层级和素材准确性。",
        "回退候选：错误资产、占位内容或移动端缺陷时退回。",
        "记录视觉决策：保留候选截图、通过项和未解决问题。"
      ],
      "title": "完整阶段说明"
    }
  ],
