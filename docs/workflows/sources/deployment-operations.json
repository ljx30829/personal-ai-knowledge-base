{
  "cards": [
    {
      "dot": "cyan",
      "items": [
        "分层验证服务、节点和部署准备，避免把本地运行写成生产健康。",
        "先只读检查分层依赖，再做本地候选和恢复演练；线上动作需授权。"
      ],
      "title": "工作目的与底层逻辑"
    },
    {
      "dot": "amber",
      "items": [
        "优先最小变更、备份和回读验证。",
        "线上部署、购买、凭据配置和服务切换必须授权。",
        "记录检查层级、命令、结果、回滚和未知。"
      ],
      "title": "执行与授权"
    },
    {
      "dot": "emerald",
      "items": [
        "诊断报告",
        "恢复步骤",
        "监控快照",
        "回读证据",
        "从最终用户行为和分层证据确认健康。"
      ],
      "title": "输出与验收"
    },
    {
      "dot": "rose",
      "items": [
        "端口或出口失败",
        "资源不足",
        "凭据缺失",
        "配置漂移"
      ],
      "title": "失败与恢复"
    },
    {
      "dot": "slate",
      "items": [
        "定义运维目标：区分诊断、恢复、预演和实际部署。",
        "确认环境边界：确认主机、项目、端口和目标平台。",
        "收集分层状态：读取容器、origin、隧道、路由、监听和出口证据。",
        "定位故障层：按本地、入口、代理、出口和目标网站顺序判断。",
        "健康与恢复验证：验证最终服务行为，不只看进程或退出码。",
        "保留阻塞状态：资源、凭据或目标不完整时不宣称已部署。",
        "更新恢复入口：记录当前状态、来源和下一次恢复步骤。"
      ],
      "title": "完整阶段说明"
    }
  ],
