{
  "cards": [
    {
      "dot": "cyan",
      "items": [
        "在本地候选、预览、质量检查和明确发布授权之间建立可回读的站点工作流。",
        "先本地检查，再只读连接，再候选上传，再 QA，发布永远单独授权。"
      ],
      "title": "工作目的与底层逻辑"
    },
    {
      "dot": "amber",
      "items": [
        "修改主题、内容、图片和转化组件。",
        "线上写入、切换主主题和发布需要明确授权。",
        "输出主题候选、截图、检查报告和回滚点。"
      ],
      "title": "执行与授权"
    },
    {
      "dot": "emerald",
      "items": [
        "本地候选",
        "预览",
        "QA 报告",
        "未发布主题",
        "Theme Check、桌面移动截图、关键路由和回读通过。"
      ],
      "title": "输出与验收"
    },
    {
      "dot": "rose",
      "items": [
        "店铺身份未知",
        "素材未授权",
        "线上状态过期",
        "发布授权缺失"
      ],
      "title": "失败与恢复"
    },
    {
      "dot": "slate",
      "items": [
        "明确站点目标：区分本地改动、预览、上传和发布。",
        "确认店铺与权限：核对目标店铺、主题角色和操作范围。",
        "读取本地与远程证据：读取状态、工作流、素材和当前主题差异。",
        "选择接入通道：区分主题 CLI、Admin API 和 Storefront API。",
        "桌面移动 QA：检查破图、溢出、占位内容、关键路由和性能。",
        "保留未发布状态：身份、数据或证据不完整时不发布。",
        "记录主题状态：记录候选、远程角色和验证时间。"
      ],
      "title": "完整阶段说明"
    }
