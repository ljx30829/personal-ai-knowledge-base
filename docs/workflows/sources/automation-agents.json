{
  "cards": [
    {
      "dot": "cyan",
      "items": [
        "把重复工作拆成受控自动化，明确状态、输入、输出和人工审批。",
        "先定义安全契约和可恢复状态，再执行只读或草稿动作，外部副作用必须审批。"
      ],
      "title": "工作目的与底层逻辑"
    },
    {
      "dot": "amber",
      "items": [
        "优先 dry-run、可回放日志和小范围验证。",
        "发送、社交、写平台、部署和购买动作必须人工批准。",
        "输出运行结果、证据、失败和下一次动作。"
      ],
      "title": "执行与授权"
    },
    {
      "dot": "emerald",
      "items": [
        "任务配置",
        "运行报告",
        "恢复步骤",
        "审计记录",
        "最终报告证明业务结果而不是仅证明任务运行。"
      ],
      "title": "输出与验收"
    },
    {
      "dot": "rose",
      "items": [
        "状态漂移",
        "外部服务失败",
        "权限过宽",
        "重试重复副作用"
      ],
      "title": "失败与恢复"
    },
    {
      "dot": "slate",
      "items": [
        "定义自动化目标：明确要减少的重复劳动和不可自动化边界。",
        "确认触发方式：区分手动、周期和事件触发。",
        "定义输入与凭据边界：只读取必要输入，不把秘密写入文件或提示词。",
        "定义状态机与停止条件：明确 ACTIVE、失败、重试、阻塞和人工接管。",
        "验证业务健康：任务 ACTIVE 或退出码成功不等于业务成功。",
        "暂停并保留状态：失败或外部状态不明时暂停自动动作。",
        "更新自动化目录：保存配置、状态、证据和恢复入口。"
      ],
      "title": "完整阶段说明"
    }
  ],
