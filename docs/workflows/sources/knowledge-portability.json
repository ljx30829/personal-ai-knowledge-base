{
  "cards": [
    {
      "dot": "cyan",
      "items": [
        "保持知识、项目状态、技能和恢复步骤可追溯、可验证、可跨设备恢复。",
        "先读取持久状态，再按来源层级更新；生成物必须通过验证后同步。"
      ],
      "title": "工作目的与底层逻辑"
    },
    {
      "dot": "amber",
      "items": [
        "按来源、哈希和过滤规则生成可恢复文件。",
        "推送前运行验证并确认不含秘密或排除内容。",
        "输出目录、清单、哈希、安装和验证方法。"
      ],
      "title": "执行与授权"
    },
    {
      "dot": "emerald",
      "items": [
        "知识页",
        "技能目录",
        "恢复包",
        "验证报告",
        "仓库验证、哈希验证和跨设备恢复演练通过。"
      ],
      "title": "输出与验收"
    },
    {
      "dot": "rose",
      "items": [
        "断链",
        "哈希不匹配",
        "秘密扫描命中",
        "来源状态过期"
      ],
      "title": "失败与恢复"
    },
    {
      "dot": "slate",
      "items": [
        "确定维护目标：区分知识更新、项目交接、技能迁移和 Git 同步。",
        "读取持久状态：先读 PROFILE、索引、任务状态和相关项目页。",
        "盘点文件与来源：区分 knowledge、projects、sources、inbox 和原始工作区。",
        "判断可信等级：保留 PASS、WATCH、FAIL、BLOCKED 和 UNVERIFIED，不把草稿升级为事实。",
        "运行仓库验证：检查结构、链接、秘密、哈希、测试和差异。",
        "停止同步并记录阻塞：验证失败时保留工作区和失败证据。",
        "写回持久状态：更新索引、任务状态、来源链接和下一步。"
      ],
      "title": "完整阶段说明"
    }
  ],
