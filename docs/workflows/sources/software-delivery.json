{
  "cards": [
    {
      "dot": "cyan",
      "items": [
        "把需求拆成可验证的实现任务，通过证据和小步提交交付代码。",
        "先理解边界和证据，再测试驱动实现，最后做差异和回归验证。"
      ],
      "title": "工作目的与底层逻辑"
    },
    {
      "dot": "amber",
      "items": [
        "先写失败测试，再用最小改动实现并重构。",
        "生产、账号、发布和破坏性操作需要明确授权。",
        "输出代码、测试、文档和提交记录。"
      ],
      "title": "执行与授权"
    },
    {
      "dot": "emerald",
      "items": [
        "代码",
        "测试",
        "提交",
        "状态记录",
        "测试和质量门有新鲜命令输出。"
      ],
      "title": "输出与验收"
    },
    {
      "dot": "rose",
      "items": [
        "测试失败",
        "依赖缺失",
        "上下文不足",
        "范围污染"
      ],
      "title": "失败与恢复"
    },
    {
      "dot": "slate",
      "items": [
        "确定交付目标：把需求改成可测试行为和非目标。",
        "恢复项目上下文：读取状态、规则、入口和最近变更。",
        "定位代码证据：读取真实调用链、配置、测试和依赖。",
        "选择实现边界：拆分独立责任，记录未知和风险。",
        "运行回归验证：运行聚焦测试、全量测试、差异和质量门。",
        "保留失败证据：测试失败或上下文不足时不宣称完成。",
        "更新项目状态：记录提交、验证、阻塞和下一步。"
      ],
      "title": "完整阶段说明"
    }
  ],
