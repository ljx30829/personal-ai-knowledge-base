{
  "cards": [
    {
      "dot": "cyan",
      "items": [
        "用公开证据和客户事实验证市场、客户群与需求，不把猜测当结论。",
        "先定义待验证问题，再建立候选池；逐条核验来源；证据不足就保留未知。"
      ],
      "title": "工作目的与底层逻辑"
    },
    {
      "dot": "amber",
      "items": [
        "建立候选池、逐项核验并淘汰不符合门槛的条目。",
        "访谈、邮件、私信、供应商联系前必须有当次授权。",
        "输出候选、证据、分数、缺口和建议下一步。"
      ],
      "title": "执行与授权"
    },
    {
      "dot": "emerald",
      "items": [
        "研究卡",
        "候选池",
        "证据矩阵",
        "下一验证步骤",
        "每个关键结论有来源或明确标记未知。"
      ],
      "title": "输出与验收"
    },
    {
      "dot": "rose",
      "items": [
        "来源受限",
        "字段缺失",
        "候选未达到验证门"
      ],
      "title": "失败与恢复"
    },
    {
      "dot": "slate",
      "items": [
        "明确研究目的：把模糊想法改成可证伪问题和停止条件。",
        "确认触发条件：确认市场、地区、客户类型和时间范围。",
        "收集公开证据：只收集可追溯的公开来源和用户授权材料。",
        "证据分层与评分：区分来源事实、作者主张、推断和未知。",
        "检查来源闭环：抽查链接、日期、来源身份和结论是否超出证据。",
        "记录研究阻塞：平台限制、字段未知或证据冲突时停止升级结论。",
        "沉淀状态与来源：把可复用方法写入知识层，项目进展写入项目层。"
      ],
      "title": "完整阶段说明"
    }
  ],
