{
  "cards": [
    {
      "dot": "cyan",
      "items": [
        "从客户问题和真实成本出发验证产品机会，再决定是否进入商品准备。",
        "客户验证先于产品决策；成本、资质、素材和平台权限全部通过后才进入草稿。"
      ],
      "title": "工作目的与底层逻辑"
    },
    {
      "dot": "amber",
      "items": [
        "形成标题、属性、描述、图片和价格草稿。",
        "写入价格、库存或上架动作必须单个测试并获授权。",
        "输出草稿、成本表、素材清单和缺口。"
      ],
      "title": "执行与授权"
    },
    {
      "dot": "emerald",
      "items": [
        "候选商品",
        "核价表",
        "商品草稿",
        "回读证据",
        "真实成本输入完整，写入动作有回读证据。"
      ],
      "title": "输出与验收"
    },
    {
      "dot": "rose",
      "items": [
        "平台权限未知",
        "成本缺失",
        "素材版权缺失",
        "需求证据不足"
      ],
      "title": "失败与恢复"
    },
    {
      "dot": "slate",
      "items": [
        "定义商品目标：明确客户、场景、类目和利润要求。",
        "确认验证门：未达到需求和付费证据门不备货。",
        "收集成本与资料：核对供应商报价、库存、运费、税费、平台费和素材权限。",
        "核算与淘汰：按真实输入核价，缺字段就标记 WATCH。",
        "写后回读验证：只在平台证明写入成功后升级状态。",
        "停止商品动作：权限、资质、素材或经济模型不完整时停止。",
        "记录商品状态：记录候选、淘汰理由和下一验证。"
      ],
      "title": "完整阶段说明"
    }
  ],
