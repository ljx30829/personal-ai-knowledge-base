{
  "cards": [
    {
      "dot": "cyan",
      "items": [
        "从合格线索到可审阅邮件草稿，经过身份、抑制、去重和授权门后才允许产生外部副作用。",
        "发现、评分、个性化、风险复核、草稿、人工确认、发送证明严格分开。"
      ],
      "title": "工作目的与底层逻辑"
    },
    {
      "dot": "amber",
      "items": [
        "只引用已核验事实，不编造价格、规格或关系。",
        "没有当次授权时停在草稿或预演，不能发送。",
        "保留草稿、收件人、证据和提供商结果。"
      ],
      "title": "执行与授权"
    },
    {
      "dot": "emerald",
      "items": [
        "草稿",
        "发送包",
        "提供商证明",
        "回复分类",
        "发送状态由提供商证据证明；失败保持阻塞。"
      ],
      "title": "输出与验收"
    },
    {
      "dot": "rose",
      "items": [
        "邮箱身份未复核",
        "退订或投诉",
        "去重失败",
        "发送授权缺失"
      ],
      "title": "失败与恢复"
    },
    {
      "dot": "slate",
      "items": [
        "明确触达目的：区分开发、回复、跟进、报价和通知。",
        "确认线索状态：只有达到线索质量门才进入邮件流程。",
        "读取公开证据：核对官网、业务匹配、邮箱来源和最近活动。",
        "风险与抑制判断：检查去重、退订、退信、投诉和身份风险。",
        "发送后核对：核对实际状态、退信、回复和退订，不以脚本退出码代替证明。",
        "阻塞并停止：身份、抑制或邮箱风险未闭环时保持 BLOCKED_NO_SEND。",
        "记录触达状态：把结果写回项目状态和线索记录。"
      ],
      "title": "完整阶段说明"
    }
  ],
