{
  "cards": [
    {
      "dot": "cyan",
      "items": [
        "把线索、回复、报价和下一步变成有证据的销售跟进状态。",
        "先分类客户意图，再核对事实和权限，最后形成可审阅的下一步。"
      ],
      "title": "工作目的与底层逻辑"
    },
    {
      "dot": "amber",
      "items": [
        "形成事实引用、问题清单和下一步草稿。",
        "发送报价、承诺交期或社交联系需要当次授权。",
        "输出回复草稿、任务、风险和等待条件。"
      ],
      "title": "执行与授权"
    },
    {
      "dot": "emerald",
      "items": [
        "回复草稿",
        "跟进任务",
        "客户状态",
        "风险记录",
        "所有承诺都有当前证据和授权。"
      ],
      "title": "输出与验收"
    },
    {
      "dot": "rose",
      "items": [
        "状态过期",
        "事实缺失",
        "客户风险未确认"
      ],
      "title": "失败与恢复"
    },
    {
      "dot": "slate",
      "items": [
        "识别销售目的：区分询价、样品、技术问题、异议和沉默跟进。",
        "读取当前状态：先读取项目状态、最近触达和阻塞项。",
        "核对客户与产品证据：不从旧草稿推断当前价格、库存或规格。",
        "判断下一步资格：根据明确需求、风险和授权决定回复、澄清或停止。",
        "复核承诺边界：确认没有把草稿、意向或旧快照写成成交。",
        "保持等待或阻塞：事实不足或客户身份不清时不推进。",
        "沉淀客户状态：更新项目交接和证据链接。"
      ],
      "title": "完整阶段说明"
    }
  ],
