{
  "cards": [
    {
      "dot": "cyan",
      "items": [
        "用自动测试、证据审查和视觉检查阻止未验证结果进入交付。",
        "先确定声明对应的验证命令，再运行完整检查，失败时保留失败状态。"
      ],
      "title": "工作目的与底层逻辑"
    },
    {
      "dot": "amber",
      "items": [
        "运行测试、lint、构建、浏览器和视觉证据。",
        "未通过的质量门阻止提交、发布或部署。",
        "记录命令、结果、范围和残余风险。"
      ],
      "title": "执行与授权"
    },
    {
      "dot": "emerald",
      "items": [
        "测试报告",
        "审查发现",
        "截图证据",
        "残余风险",
        "每个完成声明有对应新鲜证据。"
      ],
      "title": "输出与验收"
    },
    {
      "dot": "rose",
      "items": [
        "环境不可用",
        "测试失败",
        "视觉缺陷",
        "证据过期"
      ],
      "title": "失败与恢复"
    },
    {
      "dot": "slate",
      "items": [
        "定义质量声明：区分测试通过、浏览器通过和人工视觉判断。",
        "确定验证范围：选择聚焦、全量、浏览器或视觉检查。",
        "读取变更与基线：确认工作区、提交、测试和环境状态。",
        "匹配证据与声明：没有对应命令或截图就不能升级声明。",
        "复核证据新鲜度：确认结果来自当前变更和当前环境。",
        "失败即阻塞：失败不归一化为跳过或成功。",
        "记录质量状态：保留 PASS、WATCH、FAIL 和阻塞原因。"
      ],
      "title": "完整阶段说明"
    }
  ],
