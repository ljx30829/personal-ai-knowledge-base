{
  "cards": [
    {
      "dot": "cyan",
      "items": [
        "把公开或获授权内容转成带来源、覆盖率和缺口标记的可检索知识。",
        "先导入和记录来源，再转写和审计，缺媒体或平台受限时保持缺口。"
      ],
      "title": "工作目的与底层逻辑"
    },
    {
      "dot": "amber",
      "items": [
        "运行本地转写、账号构建、质量审计和蒸馏。",
        "登录、导出、发布和互动不属于默认授权。",
        "生成逐条卡片、账号报告、方法和本地索引。"
      ],
      "title": "执行与授权"
    },
    {
      "dot": "emerald",
      "items": [
        "转写",
        "质量审计",
        "知识卡",
        "本地索引",
        "每条方法有来源和覆盖状态。"
      ],
      "title": "输出与验收"
    },
    {
      "dot": "rose",
      "items": [
        "缺媒体 URL",
        "平台验证壳",
        "转写覆盖不足",
        "归属无法核验"
      ],
      "title": "失败与恢复"
    },
    {
      "dot": "slate",
      "items": [
        "定义蒸馏问题：明确需要回答的账号、内容或方法问题。",
        "确认数据授权：只处理公开或用户授权材料。",
        "准备账号工作区：导入 JSON、CSV、页面证据和媒体捕获。",
        "评估覆盖与缺口：判断页面、媒体、OCR 和转写是否足够。",
        "检查来源覆盖：核对转写覆盖、来源引用和未验证主张。",
        "保留缺口：平台验证壳或缺媒体时标记阻塞，不凑完整率。",
        "写回可复用方法：把可复用结论写入知识层，保留来源卡。"
      ],
      "title": "完整阶段说明"
    }
  ],
