{
  "cards": [
    {
      "dot": "cyan",
      "items": [
        "把选题、脚本、视觉、剪辑和发布准备组织成可审阅的内容生产闭环。",
        "先验证主题和来源，再创作，再做质量和合规检查，发布不是默认动作。"
      ],
      "title": "工作目的与底层逻辑"
    },
    {
      "dot": "amber",
      "items": [
        "完成脚本、画面、标题、描述和版本记录。",
        "发布、投放、挂卡和对外互动需要当次授权。",
        "输出脚本、媒体、标题、来源和平台适配版本。"
      ],
      "title": "执行与授权"
    },
    {
      "dot": "emerald",
      "items": [
        "脚本",
        "发布包",
        "来源卡",
        "质量报告",
        "来源、版权、格式和事实边界通过检查。"
      ],
      "title": "输出与验收"
    },
    {
      "dot": "rose",
      "items": [
        "来源不完整",
        "平台限制",
        "授权不清",
        "内容主张无法验证"
      ],
      "title": "失败与恢复"
    },
    {
      "dot": "slate",
      "items": [
        "明确内容目标：定义受众、平台、主题和成功标准。",
        "筛选选题：确认选题有来源、受众和可执行范围。",
        "整理素材与证据：记录来源、授权状态和待核验主张。",
        "确定内容结构：区分事实、观点、演示和未验证主张。",
        "内容质量门：检查来源、版权、格式、可读性和敏感风险。",
        "退回或降级：素材、授权或事实不足时只保留草稿。",
        "沉淀内容方法：把复用方法与实际结果分开记录。"
      ],
      "title": "完整阶段说明"
    }
  ],
